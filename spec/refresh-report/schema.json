{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/practice-library/graphs/spec/refresh-report/schema.json",
  "title": "Refresh report",
  "description": "What one scheduled refresh run found for one graph. The workflow uploads it as a run artifact named refresh-report; the PR opener on the maintainer's machine reads it and opens pull requests and issues. The workflow never pushes and holds no secret; the opener never fetches. spec/README.md states the rules the run follows.",
  "type": "object",
  "required": [
    "schemaVersion",
    "graph",
    "commit",
    "run",
    "requests",
    "fetches",
    "robots",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "graph": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z0-9][a-z0-9-]*$",
      "description": "<domain>/<vendor>, the directory of the graph that was refreshed."
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The commit whose nodes were read. The opener refuses a report whose commit is not an ancestor of main."
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "url",
        "startedAt",
        "finishedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "startedAt": {
          "$ref": "#/$defs/time"
        },
        "finishedAt": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "requests": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
      "description": "Every request the run made, robots.txt included, redirect hops not counted: the length of fetches, and never more than maxRequestsPerRun in policy/sources.json (scripts/report-check.py compares it with the policy; this schema only bounds it)."
    },
    "fetches": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/fetch"
      },
      "description": "Every request in the order it was made: robots.txt first, then pages. scripts/report-check.py checks the order, the hosts, the per-host counts and the sizes against policy/sources.json."
    },
    "robots": {
      "type": "array",
      "description": "robots.txt of every host the run would fetch from, fetched at the start of every run, before any page. A report with no robots record is invalid, even one with no result.",
      "items": {
        "$ref": "#/$defs/robots"
      },
      "minItems": 1
    },
    "aborted": {
      "type": "object",
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "description": "Present when the run stopped before fetching any page: a robots.txt disallows a path we fetch, refuses us (401, 403 or another 4xx but 404 and 410), throttles us (429), answers with a challenge page, or cannot be read (5xx or network error)."
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "node",
        "source",
        "fetchedAt",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
        },
        "source": {
          "$ref": "#/$defs/url",
          "description": "The node's source as it was in the commit."
        },
        "finalUrl": {
          "$ref": "#/$defs/url",
          "description": "Where the fetch ended after redirects."
        },
        "httpStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "fetchedAt": {
          "$ref": "#/$defs/time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Of the page text the quote was searched in."
        },
        "outcome": {
          "enum": [
            "unchanged",
            "changed",
            "unreadable"
          ],
          "description": "unchanged: the quote is on the page. changed: the page was read and the quote is not on it. unreadable: the page could not be read: HTTP error, 429 or 503 beyond retryAfterMaxSeconds or after the one retry, redirect to a host not in policy/sources.json, size or time cap, not text."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "The Retry-After the host sent with a 429 or 503."
        },
        "claim": {
          "enum": [
            "point",
            "latest",
            "absence",
            "aggregate"
          ],
          "description": "point: one stated fact, refreshed by finding its quote. latest, absence and aggregate claims (the newest release, nothing newer, a count over a set) are refreshed by a query over the whole relevant set, never by finding a fragment; they need a query."
        },
        "query": {
          "type": "object",
          "required": [
            "expression",
            "examined"
          ],
          "additionalProperties": false,
          "properties": {
            "expression": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The query run over the set, such as the sort and filter applied to a releases list."
            },
            "examined": {
              "type": "integer",
              "minimum": 1,
              "description": "How many members of the set the query read."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "unchanged"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "finalUrl",
              "httpStatus",
              "sha256"
            ]
          },
          "else": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "changed"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "finalUrl",
              "httpStatus",
              "sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "claim": {
                "enum": [
                  "latest",
                  "absence",
                  "aggregate"
                ]
              }
            },
            "required": [
              "claim"
            ]
          },
          "then": {
            "required": [
              "query"
            ]
          }
        }
      ]
    },
    "url": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(/[!-~]*)?$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "robots": {
      "type": "object",
      "required": [
        "host",
        "fetchedAt",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "fetchedAt": {
          "$ref": "#/$defs/time"
        },
        "httpStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "verdict": {
          "enum": [
            "allowed",
            "absent",
            "disallowed",
            "refused",
            "throttled",
            "challenge",
            "unreachable"
          ],
          "description": "allowed: robots.txt answered 2xx and permits every path the run fetches from this host. absent: 404 or 410 only, so no rule applies. disallowed: a rule forbids a path we fetch. refused: 401, 403 or another 4xx but 404, 410 and 429; an explicit refusal, never absent. throttled: 429. challenge: a bot-challenge page instead of robots.txt. unreachable: 5xx or a network error. Everything but allowed and absent aborts the run."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "absent"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "httpStatus"
            ],
            "properties": {
              "httpStatus": {
                "enum": [
                  404,
                  410
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "allowed"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "httpStatus"
            ],
            "properties": {
              "httpStatus": {
                "minimum": 200,
                "maximum": 299
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "refused"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "httpStatus"
            ],
            "properties": {
              "httpStatus": {
                "minimum": 400,
                "maximum": 499,
                "not": {
                  "enum": [
                    404,
                    410,
                    429
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "throttled"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "httpStatus"
            ],
            "properties": {
              "httpStatus": {
                "const": 429
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "unreachable"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "httpStatus": {
                "minimum": 500,
                "maximum": 599
              }
            }
          }
        }
      ]
    },
    "fetch": {
      "type": "object",
      "required": [
        "url",
        "kind",
        "bytes",
        "redirects",
        "startedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "$ref": "#/$defs/url",
          "description": "The URL requested, before redirects."
        },
        "kind": {
          "enum": [
            "robots",
            "page"
          ]
        },
        "httpStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599,
          "description": "Of the final response; absent after a network error."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000,
          "description": "Bytes read from the final response body, counted while streaming; the fetcher stops reading at the host's maxBytes."
        },
        "redirects": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/url"
          },
          "description": "Every URL the request was redirected to, in order; the last is the final URL. Each is on a listed host."
        },
        "startedAt": {
          "$ref": "#/$defs/time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "robots": {
            "contains": {
              "properties": {
                "verdict": {
                  "not": {
                    "enum": [
                      "allowed",
                      "absent"
                    ]
                  }
                }
              },
              "required": [
                "verdict"
              ]
            }
          }
        },
        "required": [
          "robots"
        ]
      },
      "then": {
        "required": [
          "aborted"
        ]
      }
    },
    {
      "if": {
        "required": [
          "aborted"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
