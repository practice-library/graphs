{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/practice-library/graphs/vendors/schema.json",
  "title": "Vendor fact node",
  "description": "One file under vendors/<vendor>/graph/nodes/, named <id>.json. The id is <type>.<vendor>.<slug>, or vendor.<vendor> for the vendor's root node. Every node of a vendor graph lives in that vendor's directory, so an edge can only point inside it; that every edge target exists is checked by et network check, not by this schema.",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "source",
    "measuredAt",
    "attrs",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "type": {
      "enum": [
        "vendor",
        "product",
        "plan",
        "price",
        "limit",
        "rate-limit",
        "permission",
        "rule",
        "feature",
        "term"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "source": {
      "$ref": "#/$defs/url",
      "description": "The official page the fact was read from; the quote is on this page."
    },
    "measuredAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "The day the quote was last confirmed on the page: a real calendar date, YYYY-MM-DD."
    },
    "attrs": {
      "type": "object",
      "required": [
        "verdict",
        "fetched_at"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "allowed",
            "denied",
            "limited",
            "unknown"
          ]
        },
        "fetched_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
          "description": "UTC, ending in Z."
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "A short sentence copied exactly from the page. Required unless the verdict is unknown."
        },
        "value": {
          "type": "number",
          "description": "A number only; its meaning is carried by unit, scope, window and currency."
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code."
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Prose that does not fit the fields above. Required when the verdict is unknown: what could not be confirmed and why."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "limited"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "unknown"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "note"
            ]
          },
          "else": {
            "required": [
              "quote"
            ]
          }
        }
      ]
    },
    "edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "rel",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "rel": {
            "enum": [
              "offeredBy",
              "availableOn",
              "requires",
              "grantedBy",
              "limits",
              "appliesTo",
              "prohibitedBy",
              "supersedes"
            ]
          },
          "to": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "vendor"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^vendor\\.[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "product"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^product\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plan"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^plan\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "price"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^price\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "limit"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^limit\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rate-limit"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^rate-limit\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "permission"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^permission\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rule"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^rule\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "feature"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^feature\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "term"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^term\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "price"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "required": [
              "value",
              "unit",
              "currency",
              "scope"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "product",
              "plan"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "edges": {
            "contains": {
              "properties": {
                "rel": {
                  "const": "offeredBy"
                },
                "to": {
                  "pattern": "^vendor\\."
                }
              },
              "required": [
                "rel",
                "to"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "vendor"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "edges": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "url": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(/[!-~]*)?$",
      "description": "https, a lower-case host name with a dot, then an optional path of printable characters without spaces."
    }
  }
}
