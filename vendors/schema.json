{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/practice-library/graphs/vendors/schema.json",
  "title": "Vendor fact node",
  "description": "One file under vendors/<vendor>/graph/nodes/, named <id>.json: the shared fact-node envelope of practice-library/.github (spec/node/schema.json), with this domain's type values and a few stricter rules. A product links to its releases with hasRelease; a capability points at the release that introduced or removed it with introducedIn or removedIn. The id is <type>.<vendor>.<slug>, or vendor.<vendor> for the vendor's root node. That every edge target exists, inside the same vendor graph, is checked by scripts/graph-check.sh, not by this schema.",
  "$ref": "https://github.com/practice-library/.github/spec/node/schema.json",
  "properties": {
    "type": {
      "enum": [
        "vendor",
        "product",
        "plan",
        "price",
        "limit",
        "rate-limit",
        "permission",
        "rule",
        "feature",
        "term",
        "release",
        "capability"
      ]
    },
    "source": {
      "maxLength": 2000,
      "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(/[!-~]*)?$",
      "description": "https, a lower-case host name with a dot, then an optional path of printable characters without spaces."
    },
    "measuredAt": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "The day the quote was last confirmed on the page: a real calendar date, YYYY-MM-DD."
    },
    "attrs": {
      "properties": {
        "fetched_at": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
          "description": "UTC, ending in Z."
        }
      },
      "if": {
        "properties": {
          "verdict": {
            "const": "unknown"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "note"
        ],
        "description": "An unknown fact says in its note what could not be confirmed and why."
      }
    },
    "edges": {
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "vendor"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^vendor\\.[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "product"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^product\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plan"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^plan\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "price"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^price\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "limit"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^limit\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rate-limit"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^rate-limit\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "permission"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^permission\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rule"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^rule\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "feature"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^feature\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "term"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^term\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "release"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^release\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "capability"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^capability\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "price"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "required": [
              "value",
              "unit",
              "scope"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "vendor"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "edges": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "release"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "required": [
              "scope"
            ],
            "properties": {
              "window": {
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
              }
            }
          }
        },
        "description": "A release names its version or model id in attrs.scope and, when the page states it, its release date in attrs.window (YYYY-MM-DD). A release flagged breaking has an attrs.note starting with \"Breaking\"."
      }
    }
  ]
}
