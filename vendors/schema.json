{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/practice-library/graphs/vendors/schema.json",
  "title": "Vendor fact node",
  "description": "One file under vendors/<vendor>/graph/nodes/, named <id>.json: the shared fact-node envelope of practice-library/.github (spec/node/schema.json), with this domain's type values and a few stricter rules. A product links to its releases with hasRelease; a capability points at the release that introduced or removed it with introducedIn or removedIn. The id is <type>.<vendor>.<slug>, or vendor.<vendor> for the vendor's root node. A command line is modelled with command, flag, argument, configuration and error nodes joined by partOf, supersedes, requires, introducedIn and removedIn; the relations aliasOf, inherits, conflictsWith, raises, deprecatedIn and precedes need the shared envelope to add them and are not used. attrs.status is not used here. That every edge target exists, inside the same vendor graph, is checked by scripts/graph-check.sh, not by this schema.",
  "$ref": "https://github.com/practice-library/.github/spec/node/schema.json",
  "properties": {
    "type": {
      "enum": [
        "vendor",
        "product",
        "plan",
        "price",
        "limit",
        "rate-limit",
        "permission",
        "rule",
        "feature",
        "term",
        "release",
        "capability",
        "command",
        "flag",
        "argument",
        "configuration",
        "error"
      ]
    },
    "source": {
      "maxLength": 2000,
      "pattern": "^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+(/[!-~]*)?$",
      "description": "https, a lower-case host name with a dot, then an optional path of printable characters without spaces."
    },
    "measuredAt": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "The day the quote was last confirmed on the page: a real calendar date, YYYY-MM-DD."
    },
    "attrs": {
      "properties": {
        "fetched_at": {
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
          "description": "UTC, ending in Z."
        },
        "status": false
      },
      "if": {
        "properties": {
          "verdict": {
            "const": "unknown"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "note"
        ],
        "description": "An unknown fact says in its note what could not be confirmed and why."
      }
    },
    "edges": {
      "uniqueItems": true,
      "items": {
        "properties": {
          "rel": {
            "enum": [
              "availableOn",
              "requires",
              "grantedBy",
              "limits",
              "appliesTo",
              "prohibitedBy",
              "supersedes",
              "hasRelease",
              "introducedIn",
              "removedIn",
              "partOf"
            ],
            "description": "Only the relations vendor graphs use. partOf is containment for a command line: a flag or argument to its command, a command to its parent command or to its product."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "vendor"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^vendor\\.[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "product"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^product\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plan"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^plan\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "price"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^price\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "limit"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^limit\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rate-limit"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^rate-limit\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "permission"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^permission\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rule"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^rule\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "feature"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^feature\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "term"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^term\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "release"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^release\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "capability"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^capability\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "command"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^command\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "flag"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^flag\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "argument"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^argument\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "configuration"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^configuration\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^error\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "price"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "required": [
              "value",
              "unit",
              "scope"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "vendor"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "edges": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "release"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "required": [
              "scope"
            ],
            "properties": {
              "window": {
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
              }
            }
          }
        },
        "description": "A release names its version or model id in attrs.scope and, when the page states it, its release date in attrs.window (YYYY-MM-DD). A release flagged breaking has an attrs.note starting with \"Breaking\"."
      }
    },
    {
      "if": {
        "properties": {
          "attrs": {
            "properties": {
              "note": {
                "pattern": "^\\s*[Aa][Bb][Ss][Ee][Nn][Tt]([^A-Za-z]|$)"
              }
            },
            "required": [
              "note"
            ]
          }
        },
        "required": [
          "attrs"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "properties": {
              "verdict": {
                "const": "unknown"
              },
              "note": {
                "pattern": "^Absent: \\S"
              }
            }
          }
        },
        "description": "A fact the page does not state is recorded as absent: verdict unknown and a note starting exactly \"Absent: \" that names the page checked. A note that starts with the word absent in any other form is rejected, so the convention cannot drift. The envelope has no absent verdict yet (practice-library/.github#20)."
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "command"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "required": [
              "scope",
              "quote"
            ]
          }
        }
      },
      "description": "A command is one invocable command, id command.<vendor>.<tool>.<path words>. attrs.scope is its usage line and attrs.quote its summary. A subcommand is partOf its parent command, a top-level command partOf the product; scripts/graph-check.sh checks that, and vendors/<vendor>/inventory.json lists the command paths a release has."
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "flag",
              "argument",
              "configuration",
              "error"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "required": [
              "scope"
            ]
          }
        }
      },
      "description": "A flag (attrs.scope --name, partOf its command or the product for a global flag), an argument (attrs.scope its name, partOf its command), a configuration setting or environment variable (attrs.scope its key) and an error or exit code (attrs.scope the code) each name themselves in attrs.scope."
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "flag",
              "error"
            ]
          },
          "attrs": {
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "type",
          "attrs"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "required": [
              "unit"
            ]
          }
        }
      },
      "description": "A default, a range or an exit code in attrs.value carries its unit in attrs.unit."
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          },
          "attrs": {
            "required": [
              "value"
            ]
          }
        },
        "required": [
          "type",
          "attrs"
        ]
      },
      "then": {
        "properties": {
          "attrs": {
            "properties": {
              "unit": {
                "const": "exit-code"
              }
            }
          }
        }
      },
      "description": "An exit code is an error with attrs.value its number and attrs.unit exit-code."
    }
  ]
}
